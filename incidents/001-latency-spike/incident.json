          { "id": "db-pool", "label": "The database connection pool" },
          { "id": "db-server", "label": "The database server (CPU or I/O)" },
          { "id": "event-loop", "label": "The Node.js event loop (main thread)" },
          { "id": "threadpool", "label": "The libuv thread pool" },
          { "id": "memory", "label": "Memory / the garbage collector" },
          { "id": "downstream", "label": "A downstream dependency or the network" }
