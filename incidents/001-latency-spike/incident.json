          { "id": "slow-query", "label": "A slow or unindexed SQL query" },
          { "id": "cpu-sync", "label": "CPU-heavy synchronous JavaScript on the request path" },
          { "id": "leak", "label": "A memory leak" },
          { "id": "locks", "label": "Lock contention in the database" },
          { "id": "pool-leak", "label": "Database connections that are never released" },
          { "id": "retries", "label": "Retries amplifying the load" }
