{
  "name": "shopflow-api",
  "version": "2.24.0",
  "description": "ShopFlow e-commerce API: catalog, checkout, customer accounts and finance reports.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
