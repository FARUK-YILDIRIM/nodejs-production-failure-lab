+/** Handles one order event; a failure is logged, not thrown. */
+async function handle(message: KafkaMessage): Promise<void> {
+  const event = JSON.parse(message.value?.toString() ?? '{}') as OrderPlaced;
+  try {
+    await confirm(event);
+  } catch (err) {
+    // MailWave was retried already; one email isn't worth stopping the others for.
+    confirmationFailures.inc();
+    logger.error({ err, orderId: event.orderId }, 'order confirmation email could not be sent');
+  }
+}
+
+// MailWave takes ~650 ms per email: one at a time, that's 1.5 emails per second,
+// fewer than the orders coming in. Emails don't depend on each other, so send up
+// to 32 at once.
+const CONCURRENCY = 32;
